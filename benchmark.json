{
  "schemaVersion": 1,
  "name": "mlxfast-challenge-dev",
  "description": "Optimize Gemma 4 31B 4-bit dense inference by transforming weights offline and reducing compute latency without failing the correctness gate.",
  "category": "swift",
  "direction": "+",
  "editablePaths": [
    "Sources/MLXFastModel",
    "Sources/MLXFastTransform"
  ],
  "setupCommand": ["bash", "-c", "./setup.sh"],
  "preSubmitCommand": ["bash", "-c", "./benchmark.sh --local-submit"],
  "benchmarkCommand": ["bash", "-c", "MLXFAST_SCORE_PATH=score.json ./benchmark.sh --local-iterate"],
  "scorePath": "score.json",
  "runner": {
    "provider": "github-actions",
    "workflow": "benchmark.yml"
  }
}
